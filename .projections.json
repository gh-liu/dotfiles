{
  "xdg_config/zsh/.zshrc": {
    "type": "zshrc"
  },
  "xdg_config/zsh/completion.zsh": {
    "type": "zshcompletion"
  },
  "xdg_config/zsh/zsh-conf/custom.zsh": {
    "type": "zshcustom"
  },
  "xdg_config/zsh/starship/starship.toml": {
    "type": "startship"
  },
  "xdg_config/agents/AGENTS.md": {
    "type": "agentmd"
  },
  "xdg_config/wsl/.wslconfig": {
    "type": "wsl"
  },
  "xdg_config/ghostty/config": {
    "type": "ghostty"
  },
  "xdg_config/rex/init.lua": {
    "type": "rex",
    "dispatch": ":lua vim.ui.open(\"https://www.superlogical.com/rex/docs/customize/config\")"
  },
  "xdg_config/rex/api_gen.lua": {
    "dispatch": ":!rex do %"
  },
  "xdg_config/kitty/kitty.conf": {
    "type": "kitty"
  },
  "xdg_config/wezterm/wezterm.lua": {
    "type": "wezterm"
  },
  "xdg_config/tmux/tmux.conf": {
    "type": "tmux"
  }
}
