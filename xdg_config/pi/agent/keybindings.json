{
  "$schema": "https://pi.dev/schemas/keybindings.schema.json",
  "tui.editor.cursorUp": [
    "up",
    "ctrl+p"
  ],
  "tui.editor.cursorDown": [
    "down",
    "ctrl+n"
  ],
  "tui.select.up": [
    "up",
    "ctrl+p"
  ],
  "tui.select.down": [
    "down",
    "ctrl+n"
  ],
  "tui.altScreen.previousPrompt": "ctrl+shift+k",
  "tui.altScreen.nextPrompt": "ctrl+shift+j",
  "tui.altScreen.halfPageUp": "",
  "tui.altScreen.halfPageDown": "",
  "tui.altScreen.top": "",
