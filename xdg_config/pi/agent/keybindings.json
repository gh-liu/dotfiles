{
  "$schema": "https://pi.dev/schemas/keybindings.schema.json",
  "tui.editor.cursorUp": [
    "up",
    "ctrl+p"
  ],
  "tui.editor.cursorDown": [
    "down",
    "ctrl+n"
  ],
  "tui.select.up": [
    "up",
    "ctrl+p"
  ],
  "tui.select.down": [
    "down",
    "ctrl+n"
  ],
  "tui.altScreen.previousPrompt": "ctrl+alt+p",
  "tui.altScreen.nextPrompt": "ctrl+alt+n",
  "tui.altScreen.halfPageUp": "ctrl+alt+u",
  "tui.altScreen.halfPageDown": "ctrl+alt+d",
  "tui.altScreen.top": "ctrl+alt+t",
  "tui.altScreen.bottom": "ctrl+alt+b",
  "app.models.toggleProvider": [],
  "app.model.cycleForward": [],
  "app.model.cycleBackward": [],
  "app.tree.foldOrUp": [
    "ctrl+alt+h"
  ],
  "app.tree.unfoldOrDown": [
    "ctrl+alt+l"
  ],
  "app.session.new": [
    "ctrl+s"
  ],
  "app.session.resume": [
    "ctrl+r"
  ],
  "app.session.tree": [
    "ctrl+up",
    "ctrl+down"
  ],
  "app.session.toggleNamedFilter": [
    "ctrl+l"
  ],
  "app.session.togglePath": [
    "ctrl+x"
  ]
}
