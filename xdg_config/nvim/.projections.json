{
  "lua/liu/lsp/init.lua": {
    "type": "Lsp"
  },
  "lua/liu/lsp/servers/*.lua": {
    "type": "LspEx",
    "alternate": "after/lsp/{}.lua"
  },
  "after/lsp/*.lua": {
    "type": "LspServers",
    "alternate": "lua/liu/lsp/servers/{}.lua",
    "template": [
      "---@type vim.lsp.Config",
      "local Config = {open}{close}",
      "return Config"
    ]
  },
  "lua/liu/dap/init.lua": {
    "type": "Dap"
  },
  "lua/liu/dap/adapters/*.lua": {
    "type": "DapAdapters"
  },
  "snippets/*.json": {
    "type": "snippet"
  },
  "after/ftplugin/*.lua": {
    "type": "ftplugin"
  },
  "after/plugin/*.lua": {
    "type": "plugin"
  },
  "after/plugin/*.vim": {
    "type": "plugin"
  }
}
