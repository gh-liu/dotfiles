#!/usr/bin/env python3
"""Print current opencode Zen "Go" plan usage.

Endpoint (undocumented, found by probing; not in docs or sst/opencode routes):
    GET https://opencode.ai/zen/go/v1/usage
    Authorization: Bearer $OPENCODE_API_KEY
Response:
    {"usage":{"rolling":{"status":"ok","percent":33,"resetsAt":"..."},
              "weekly":{...},"monthly":{...}}}
Related upstream feature requests: sst/opencode issues #16017 #18648
"""
import json
import os
import time
import urllib.request
from datetime import datetime
from zoneinfo import ZoneInfo

API_URL_USAGE = "https://opencode.ai/zen/go/v1/usage"
TIMEZONE = ZoneInfo(os.environ.get("TZ", "Asia/Shanghai"))
RETRIES = 3


def fetch(url):
    key = os.environ.get("OPENCODE_API_KEY")
    if not key:
        raise SystemExit("OPENCODE_API_KEY not set")
    headers = {"Authorization": f"Bearer {key}", "User-Agent": "curl/8.9.1"}
    last_err = None
    for attempt in range(RETRIES):
        try:
            request = urllib.request.Request(url, headers=headers)
            return urllib.request.urlopen(request, timeout=15).read().decode()
        except Exception as err:  # transient network errors happen often here
            last_err = err
            time.sleep(1)
    raise SystemExit(f"request failed after {RETRIES} attempts: {last_err}")


def fmt_reset(iso_str):
    dt = datetime.fromisoformat(iso_str.replace("Z", "+00:00"))
    return dt.astimezone(TIMEZONE).strftime("%Y-%m-%d %H:%M:%S %Z")


payload = json.loads(fetch(API_URL_USAGE))
usage = payload.get("usage")
if not usage:
    raise SystemExit(f"unexpected response: {payload}")

print("# opencode Go plan usage")
for window in ("rolling", "weekly", "monthly"):
    entry = usage.get(window)
    if not entry:
        continue
    print(
        f"{window:<9} used {entry.get('percent', '?'):>3}%"
        f"  ({entry.get('status', 'unknown')})"
        f"  resets {fmt_reset(entry['resetsAt'])}"
    )
