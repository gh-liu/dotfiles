#!/bin/sh

# unfollow
#
# https://docs.github.com/en/rest/users/followers?apiVersion=2022-11-28#list-the-people-the-authenticated-user-follows
# https://docs.github.com/en/rest/users/followers?apiVersion=2022-11-28#unfollow-a-user

gh api \
        -H "Accept: application/vnd.github+json" \
        -H "X-GitHub-Api-Version: 2022-11-28" \
        /user/following?per_page=100 |
        jq -r '.[].login' |
        while read -r user; do
                echo "unfollow $user"
                gh api \
                        --method DELETE \
                        -H "Accept: application/vnd.github+json" \
                        -H "X-GitHub-Api-Version: 2022-11-28" \
                        /user/following/$user
        done

# unstar
#
# https://docs.github.com/en/rest/activity/starring?apiVersion=2022-11-28#list-repositories-starred-by-the-authenticated-user
# https://docs.github.com/en/rest/activity/starring?apiVersion=2022-11-28#unstar-a-repository-for-the-authenticated-user

gh api \
        -H "Accept: application/vnd.github+json" \
        -H "X-GitHub-Api-Version: 2022-11-28" \
        /user/starred?per_page=100 |
        jq -r '.[].full_name' |
        while read -r repo; do
                echo "unstar $repo"
                gh api \
                        --method DELETE \
                        -H "Accept: application/vnd.github+json" \
                        -H "X-GitHub-Api-Version: 2022-11-28" \
                        /user/starred/$repo
        done
